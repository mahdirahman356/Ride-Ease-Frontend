{
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/" }
  ],
  "env": {},
  "installCommand": "bun install",
  "buildCommand": "bun build src/main.jsx --outdir dist",
  "outputDirectory": "dist"
}
